# ===== Bắt buộc =====
# Tên miền (không có https://), dùng cho Caddy
SITE_DOMAIN=renco.vn
NEXT_PUBLIC_SITE_URL=https://renco.vn
# production: cho phép index; staging/dev: robots chặn toàn bộ
SITE_ENV=production

# Chuỗi bí mật ngẫu nhiên ≥ 32 ký tự: openssl rand -hex 32
PAYLOAD_SECRET=
# Dùng riêng cho liên kết tải tài liệu có chữ ký và băm IP (tách khỏi PAYLOAD_SECRET)
DOWNLOAD_SIGNING_SECRET=
IP_HASH_SALT=

POSTGRES_USER=renco
POSTGRES_PASSWORD=
POSTGRES_DB=renco
# Chạy ngoài docker compose thì khai DATABASE_URL đầy đủ
# DATABASE_URL=postgres://renco:mat-khau@127.0.0.1:5432/renco

# Thư mục lưu ảnh, PDF (volume được sao lưu hằng ngày)
UPLOAD_DIR=/data/uploads

# ===== Email giao dịch (SPF, DKIM, DMARC cho renco.vn) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@renco.vn
EMAIL_FROM_NAME=RENCO

# ===== Bảo vệ =====
# IP được vào /admin (phân tách bằng dấu cách), ghi cả IPv4 và IPv6, ví dụ "203.0.113.10 2001:db8:10::/48".
# "0.0.0.0/0 ::/0" = mọi IP (chỉ dùng khi đã có Cloudflare Access). Chỉ ghi 0.0.0.0/0 thì máy dùng IPv6 bị chặn.
ADMIN_ALLOW_IPS="0.0.0.0/0 ::/0"
# Cloudflare Turnstile chống bot ở form. Production BẮT BUỘC có khoá:
# thiếu TURNSTILE_SECRET_KEY thì mọi form bị từ chối (trả captcha_failed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chỉ đặt true trên staging chưa có khoá Turnstile. Không đặt ở production.
TURNSTILE_OPTIONAL=false
# Số lần gửi form tối đa mỗi IP mỗi 10 phút
FORM_RATE_LIMIT=5

# ===== Đo lường (Umami tự lưu trữ, không cookie) =====
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=

# ===== Vận hành =====
# Thời hạn giữ lead trước khi ẩn danh hoá (tháng) — chốt theo WB02
LEAD_RETENTION_MONTHS=24
# Đặt true để tạm dừng tác vụ nền (email, nhắc việc) khi bảo trì
DISABLE_JOBS=false
# Chỉ đặt true trong môi trường test tự động
TOTP_DISABLED=false
